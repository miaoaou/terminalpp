    \ifnum\ListeCoeff[4]>0
    +\Affichage[Lettre=#1]{0}{0}{\ListeCoeff[4]}
    \else
    \Affichage[Lettre=#1]{0}{0}{\ListeCoeff[4]}
    \fi
    \fi
    \else
    \ifnum\ListeCoeff[3]>0\relax
    +\Affichage[Lettre=#1]{0}{\ListeCoeff[3]}{\ListeCoeff[4]}
    \else
    \Affichage[Lettre=#1]{0}{\ListeCoeff[3]}{\ListeCoeff[4]}
    \fi
    \fi
    \else
    \ifnum\ListeCoeff[2]>0\relax
