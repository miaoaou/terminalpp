  \ensuremath{
    \ifnum\ListeCoeff[1]=0\relax
    \Affichage{\ListeCoeff[2]}{\ListeCoeff[3]}{\ListeCoeff[4]}%
    \else
    \ifnum\ListeCoeff[1]=1\relax
    #1^3%
    \else\ifnum\ListeCoeff[1]=-1\relax
    -#1^3
    \else\num{\ListeCoeff[1]}#1^3
