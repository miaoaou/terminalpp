\renewcommand{\pagecolor}[1]{\@bsphack%
  \edef\pagecolortmpa{#1}%
  \def\pagecolortmpb{none}%
  \ifx\pagecolortmpa\pagecolortmpb\relax%
    \ifdefined\nopagecolor\relax%
      \nopagecolor%
