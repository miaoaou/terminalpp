 RELOC/fonts/source/public/esint/esint10.mf
 RELOC/fonts/source/public/esint/mathint.mf
 RELOC/fonts/tfm/public/esint/esint10.tfm
 RELOC/tex/latex/esint/esint.sty
 RELOC/tex/latex/esint/uesint.fd
catalogue-also esint-type1
catalogue-ctan /macros/latex/contrib/esint
