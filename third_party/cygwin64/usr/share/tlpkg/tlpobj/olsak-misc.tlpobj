 RELOC/tex/generic/olsak-misc/qrcode.tex
 RELOC/tex/generic/olsak-misc/scanbase.tex
 RELOC/tex/generic/olsak-misc/scancsv.tex
 RELOC/tex/generic/olsak-misc/xmlparser.tex
